# DRAFT — add to .env.local when enabling Plaid (keep PLAID_SECRET server-only)

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# 32+ char random string — encrypts access tokens at rest
PLAID_TOKEN_ENCRYPTION_KEY=
# Public URL for webhooks (ngrok in dev, https://your-app.vercel.app in prod)
APP_URL=http://localhost:3000
# Vercel Cron auth: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Server routes only — never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
